rules_version = '2';

// AttendSync Firestore security rules — v2
// Fix: attendance & internalMarks now cover ALL levels (subjects → dates → ...)

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() &&
        (myRole() == 'admin' || myRole() == 'master admin' ||
         myRole() == 'hod'   || myRole() == 'coordinator');
    }

    // ── USERS ────────────────────────────────────────────
    match /users/{phone} {
      allow read: if isSignedIn();

      allow create: if request.resource.data.status == 'pending'
                    && !('pin' in request.resource.data);

      allow update: if
        (isSignedIn() && request.auth.uid == phone) ||
        isAdmin() ||
        (
          resource.data.status == 'approved' &&
          !('pin' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin'])
        );

      allow delete: if isAdmin();
    }

    // ── SECTIONS (roster metadata) ───────────────────────
    match /sections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── STUDENTS (academic records — sensitive) ──────────
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── ATTENDANCE (covers subjects, dates, and any deeper levels) ──
    match /attendance/{document=**} {
      allow read, write: if isSignedIn();
    }

    // ── INTERNAL MARKS (covers subjects and any deeper levels) ──
    match /internalMarks/{document=**} {
      allow read, write: if isSignedIn();
    }

    // ── Everything else: locked by default ───────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}