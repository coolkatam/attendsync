rules_version = '2';

// Mech EMS Storage rules — profile photos only.
// Photos are readable by any signed-in user (directory, HoD views);
// a faculty member can only upload/replace their OWN photo.
// Max 3MB, images only.

service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{phone} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == phone
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
